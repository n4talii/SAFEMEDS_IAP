# Server Configuration
PORT=3000

# Supabase Database Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# API Key Authentication
# Provide a comma-separated list of valid API keys for your consumers
API_KEYS=your-consumer-key-1,your-consumer-key-2,your-internal-key-1

# Single key fallback (optional)
MAJIAPP_API_KEY=your-private-api-key-here

# Optional Feature Modes
HEALTH_SIGNALS_MODE=demo